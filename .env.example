# Copy this file to .env and fill in your values.
# .env is gitignored - never commit real credentials.

# --- Core ServiceNow connection ---
SN_INSTANCE_URL=https://your-instance.service-now.com

# --- Azure App Service / Entra app credentials for ServiceNow token flow ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SCOPE=

# --- Snapshot sync defaults (app + sync_snapshot.py) ---
DB_PATH=db/data.sqlite
SN_SINCE_DAYS=365
SN_INCIDENT_MAX=5000
# Leave blank to auto-behave: >=365-day runs pull all request items; shorter runs default to 5000.
SN_REQUEST_MAX=
SN_CHANGE_MAX=3000
SN_PROBLEM_MAX=3000
SN_TIMEOUT=20

# AZURE_SCOPE can be left empty to default to <AZURE_CLIENT_ID>/.default
# For API ID URI-based scopes, set explicitly (example):
# AZURE_SCOPE=api://[app-id-uri]/.default